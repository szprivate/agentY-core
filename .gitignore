__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.eggs/

# Regenerable, environment-specific build input for the recipe generator
# (node signatures from a running ComfyUI). The distilled outputs
# (workflow_recipes*.json) are committed; this large cache is not.
config/workflow_recipes_object_info_cache.json

# Example workflows of the node packs installed in the local ComfyUI, mirrored
# at agent startup (templates_sync.sync_node_pack_examples). A fact about one
# machine, and other people's files: never committed.
comfyui_workflow_templates_custom/templates/node_packs/

# Jobs solved on this machine, saved as templates for the next matching request
# (agenty_core/tools/local_templates.py). A user's own work: never committed, and
# the recipe generator skips the folder.
comfyui_workflow_templates_custom/templates/local/
agenty_core/motion_graphics/**/_preview/

# Local env files and per-machine credentials.
.env
.env.*
!.env_example
!.env.example
config/settings.local.json
config/.mcp_tokens/
config/mcp_bundles/
.agenty_token*

# ── Secrets audit 2026-10-29: things that must never be addable ─────────────
# Key/credential files of any name, and private keys.
keys*.txt
*.pem
*.p12
*.pfx
id_rsa*
# Conversation / memory databases and archives of them: full chat history,
# tool results (which have held .env contents) and prompts.
memory.zip
*.sqlite
*.sqlite3
*.db
# Logs (message history, token logs, MCP server logs) and tool caches.
/logs/
.logs/
.playwright-mcp/
.cache/
.remotion/
/output/
